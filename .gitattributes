# Windows scripts keep their CRLF line endings exactly as committed.
*.bat -text

# Unix scripts and sources use LF.
gradlew text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.py text eol=lf
*.md text eol=lf

# Binary files.
*.jar binary
*.ttf binary
*.png binary
